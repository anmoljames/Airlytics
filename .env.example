# =============================================================================
# Airlytics — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in the values you want to enable.
# EVERYTHING IS OPTIONAL: the dashboard runs fully without any of these.
#
#   copy .env.example .env
#
# `.env` is git-ignored. Never paste real credentials into this file.
# =============================================================================

# --- Hazard email (SMTP over Gmail) ---------------------------------------
# Create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be switched on).
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_RECIPIENT=

# --- Google Drive mirror ---------------------------------------------------
# Path to a service-account JSON key file. Keep that file OUTSIDE the repo.
GOOGLE_APPLICATION_CREDENTIALS=
# Target folder id (the long string in a Drive folder URL):
#   https://drive.google.com/drive/folders/<FOLDER_ID>
GCP_DRIVE_FOLDER_ID=

# --- Amazon S3 + SNS -------------------------------------------------------
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=
SNS_TOPIC_ARN=
# Either set these, or rely on `aws configure` / an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
